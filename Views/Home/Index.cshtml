@{
    var isLoggedIn = Context.Session.GetString("Role") == "User";
    Layout = isLoggedIn
        ? "~/Views/Shared/_UserLayout.cshtml"
        : "~/Views/Shared/_GuestLayout.cshtml";
    ViewData["Title"] = "Home";
}

<!-- HERO SECTION -->
<section class="text-center py-5" style="background:#f9f9f9;">
    <div class="container py-4">
        <h1 class="fw-bold display-5">Making Every Event</h1>
        <h1 class="fw-bold display-5" style="color:#e8450a;">Memorable</h1>
        <p class="text-muted mt-3" style="max-width:550px; margin:auto; line-height:1.8;">
            Eventalk is your all-in-one platform to discover, join, and manage events
            effortlessly. Whether you're attending a tech summit, a music fest, or a
            community meetup — we make every experience seamless from registration to check-in.
        </p>
        <a href="@(isLoggedIn ? "/User/Events" : "/Event/Index")"
           class="btn mt-3 text-white fw-semibold px-4 py-2"
           style="background-color:#e8450a; border-radius:6px;">
            Explore Events
        </a>
    </div>
</section>

<!-- STATS SECTION (Dynamic) -->
<section style="background:#000000; color:white;">
    <div class="container">
        <div class="row text-center py-4">
            <div class="col-6 col-md-3 py-3">
                <div class="fw-bold fs-4">@ViewBag.TotalEvents+</div>
                <div style="color:#aaa;">Events Organized</div>
            </div>
            <div class="col-6 col-md-3 py-3">
                <div class="fw-bold fs-4">@ViewBag.TotalRegistrations+</div>
                <div style="color:#aaa;">User Registrations</div>
            </div>
            <div class="col-6 col-md-3 py-3">
                <div class="fw-bold fs-4">@ViewBag.AvgRating/5</div>
                <div style="color:#aaa;">User Rating</div>
            </div>
            <div class="col-6 col-md-3 py-3">
                <div class="fw-bold fs-4">@ViewBag.ActiveEvents+</div>
                <div style="color:#aaa;">Active Events</div>
            </div>
        </div>
    </div>
</section>

<!-- FEATURES SECTION -->
<section style="background:#f4f4f4;">
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 rounded-3 p-4 h-100 shadow-sm">
                    <div class="mb-3" style="color:#e8450a; font-size:1.8rem;">
                        <i class="bi bi-person-check"></i>
                    </div>
                    <h6 class="fw-bold">Easy Registration</h6>
                    <p class="text-muted small">
                        Attendees can register in seconds. Our optimized flow reduces
                        drop-offs and increases ticket sales.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 rounded-3 p-4 h-100 shadow-sm">
                    <div class="mb-3" style="color:#e8450a; font-size:1.8rem;">
                        <i class="bi bi-bar-chart-line"></i>
                    </div>
                    <h6 class="fw-bold">Admin Controls</h6>
                    <p class="text-muted small">
                        Manage everything from one dashboard. Track sales, manage
                        guest lists, and issue refunds instantly.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 rounded-3 p-4 h-100 shadow-sm">
                    <div class="mb-3" style="color:#e8450a; font-size:1.8rem;">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <h6 class="fw-bold">Secure Data</h6>
                    <p class="text-muted small">
                        Your user data is encrypted and safe. We prioritize privacy
                        and security for all event organizers.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>