@model EventOrganizer_ASP.NET.Models.User
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Register - Eventtalk</title>

    <!-- FIXED CDN (you had typo: mian.css ❌) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
</head>

<body class="bg-light">

    <!-- Back -->
    <div class="position-absolute top-0 start-0 m-4">
        <a href="/Account/Login" class="text-decoration-none text-secondary fw-semibold">
            <i class="bi bi-arrow-left"></i> Back to Login
        </a>
    </div>

    <div class="container vh-100 d-flex justify-content-center align-items-center">

        <!-- CARD -->
        <div class="col-md-5 col-lg-4">

            <div class="border rounded-4 shadow-sm p-4 bg-white">

                <!-- Heading -->
                <div class="text-center mb-4">
                    <h3 class="fw-bold">Create an account</h3>
                    <p class="text-muted small">
                        Start your journey with Eventtalk today.
                    </p>
                </div>

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <form asp-action="Register" asp-controller="Account" method="post">

                    <!-- Full Name -->
                    <label class="fw-semibold small">Full Name</label>
                    <div class="input-group mb-3">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-person text-muted"></i>
                        </span>
                        <input asp-for="FullName" class="form-control" placeholder="Kris Kalariya" required />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <!-- Email -->
                    <label class="fw-semibold small">Email Address</label>
                    <div class="input-group mb-3">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-envelope text-muted"></i>
                        </span>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Password -->
                    <label class="fw-semibold small">Password</label>
                    <div class="input-group mb-1">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-lock text-muted"></i>
                        </span>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Create a strong password" required />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    @* <div class="text-muted small mb-3">
                        Must be at least 6 characters long.
                    </div> *@

                    <!-- Button -->
                    <button type="submit" class="btn w-100 text-white fw-semibold py-2"
                            style="background:#ff6b00;">
                        Create Account
                    </button>

                </form>

                <!-- Bottom -->
                <div class="text-center mt-3">
                    <span class="text-muted small">Already have an account? </span>
                    <a href="/Account/Login" class="fw-semibold text-decoration-none"
                       style="color:#ff6b00;">
                        Sign in
                    </a>
                </div>

            </div>

        </div>
    </div>

</body>
</html>